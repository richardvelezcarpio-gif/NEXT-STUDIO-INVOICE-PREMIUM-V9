# PayPal Sandbox configuration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=PASTE_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=PASTE_SANDBOX_CLIENT_SECRET

# Created automatically by setup-paypal.mjs, or paste an existing plan ID
PAYPAL_PLAN_ID=

# Optional, required only when enabling verified webhooks
PAYPAL_WEBHOOK_ID=

PORT=8083
BASE_URL=http://localhost:8083
